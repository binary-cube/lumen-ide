# ------------------------------------------- #
# More information at http://editorconfig.org #
# ------------------------------------------- #
# Taken from docker.delucru.ro (F1 1.3).

root = true

[*]
charset                  = utf-8
end_of_line              = lf
indent_style             = space
indent_size              = 4
trim_trailing_whitespace = true
insert_final_newline     = true
max_line_length          = 120

[*.md]
trim_trailing_whitespace = false
insert_final_newline     = false

[Makefile]
indent_style = tab
